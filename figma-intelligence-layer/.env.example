# ─────────────────────────────────────────────────────────────────────────────
# figma-intelligence-layer — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# Required ──────────────────────────────────────────────────────────────────
FIGMA_ACCESS_TOKEN=figd_YOUR_TOKEN_HERE
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Figma Desktop Bridge ───────────────────────────────────────────────────────
FIGMA_BRIDGE_PORT=9001
FIGMA_REQUEST_TIMEOUT=30000

# Vision model ───────────────────────────────────────────────────────────────
# Choose one: openai | anthropic
VISION_PROVIDER=openai
# Used as fallback when a provider-specific model env var is not set
VISION_MODEL=gpt-4.1-mini
VISION_DETAIL_LEVEL=high
CLONE_CONFIDENCE_THRESHOLD=0.75
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
ANTHROPIC_VISION_MODEL=claude-sonnet-4-20250514

# Features ───────────────────────────────────────────────────────────────────
ENABLE_DECISION_LOG=true
ENABLE_WEBHOOKS=false          # opt-in — requires a public endpoint

# Decision log path ──────────────────────────────────────────────────────────
DECISION_LOG_PATH=./.decision-log.json
LINT_RULES_PATH=./.lint-rules.json
WEBHOOK_CONFIG_PATH=./.webhooks.json

# Notifications (optional) ───────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
GITHUB_TOKEN=ghp_YOUR_TOKEN

# Playwright screenshot service ──────────────────────────────────────────────
# Uses system Chromium by default; set to 'webkit' or 'firefox' if needed.
PLAYWRIGHT_BROWSER=chromium
